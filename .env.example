# Puerto HTTP de la aplicación.
SERVER_PORT=8081

# Publica Swagger UI en /swagger-ui.html y el JSON OpenAPI en /v3/api-docs.
# Solo para desarrollo. El perfil prod la mantiene apagada aunque esta variable
# valga true, para no exponer el contrato de la API en producción.
API_DOCUMENTATION_ENABLED=true

# Conexión a PostgreSQL cuando la aplicación corre fuera de Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB-cuentas
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password

# Solo para docker-compose: puerto del host que se publica hacia el PostgreSQL del
# contenedor. Cámbielo si el 5432 ya está ocupado por un PostgreSQL instalado
# localmente. No afecta la conexión de la aplicación, que usa la red de Compose.
DB_PORT_HOST=5433

# --- Firebase Admin SDK ---
# Firebase custodia las credenciales de los usuarios: el registro crea ahí la cuenta y
# escribe el custom claim del plan. Sin estas variables la aplicación no arranca, porque
# un microservicio de cuentas sin Firebase aceptaría registros que no podría completar.

# Identificador del proyecto en Firebase Console. Obligatorio.
FIREBASE_PROJECT_ID=cameia-dev

# Ruta al JSON de la cuenta de servicio. Es un archivo de desarrollo local y nunca se
# versiona: pídaselo a quien administra el proyecto de Firebase. Fuera de Docker use la
# ruta del archivo en su máquina; con docker-compose esa ruta se monta dentro del
# contenedor, así que aquí va la del host.
# En Cloud Run se deja vacía: las credenciales salen del entorno con la identidad de la
# cuenta de servicio del despliegue.
FIREBASE_KEY_PATH=C:/ruta/absoluta/a/firebase-service-account.json

# Apaga el SDK por completo. Solo para levantar la aplicación sin credenciales, por
# ejemplo para revisar la documentación de la API. Con false, el registro de usuarios no
# funciona. En despliegue siempre true.
FIREBASE_ENABLED=true
