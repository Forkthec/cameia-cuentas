# Puerto HTTP de la aplicación.
SERVER_PORT=8081

# Conexión a PostgreSQL cuando la aplicación corre fuera de Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB-cuentas
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password

# Solo para docker-compose: puerto del host que se publica hacia el PostgreSQL del
# contenedor. Cámbielo si el 5432 ya está ocupado por un PostgreSQL instalado
# localmente. No afecta la conexión de la aplicación, que usa la red de Compose.
DB_PORT_HOST=5433
