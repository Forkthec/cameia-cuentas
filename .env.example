# Puerto HTTP de la aplicación.
SERVER_PORT=8081

# Publica Swagger UI en /swagger-ui.html y el JSON OpenAPI en /v3/api-docs.
# Solo para desarrollo. El perfil prod la mantiene apagada aunque esta variable
# valga true, para no exponer el contrato de la API en producción.
API_DOCUMENTATION_ENABLED=true

# Conexión a PostgreSQL cuando la aplicación corre fuera de Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB-cuentas
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password

# Solo para docker-compose: puerto del host que se publica hacia el PostgreSQL del
# contenedor. Cámbielo si el 5432 ya está ocupado por un PostgreSQL instalado
# localmente. No afecta la conexión de la aplicación, que usa la red de Compose.
DB_PORT_HOST=5433

# --- Firebase Admin SDK ---
# Firebase custodia las credenciales de los usuarios: el registro crea ahí la cuenta y
# escribe el custom claim del plan. Sin estas variables la aplicación no arranca, porque
# un microservicio de cuentas sin Firebase aceptaría registros que no podría completar.

# Por defecto se usa el emulador de Firebase Auth: no necesita llave de cuenta de servicio ni
# un proyecto real, y sus usuarios solo existen en su máquina. El emulador es un servicio
# aparte, compartido con el resto de los servicios, que se levanta desde el compose del gateway
# en la misma red cameia-net.

# Identificador del proyecto. Obligatorio. Con el emulador debe ser el ID del emulador,
# demo-cameia. Con un proyecto real, el ID de ese proyecto en Firebase Console.
FIREBASE_PROJECT_ID=demo-cameia

# Dirección del emulador dentro de cameia-net. Con esta variable definida la aplicación no pide
# credenciales de Google, ignora FIREBASE_KEY_PATH y acepta tokens sin firma, por eso se niega a
# arrancar si la ve en un despliegue (Cloud Run o perfil prod), aunque esté vacía.
# Para usar un proyecto REAL de Firebase: comente esta línea, cambie FIREBASE_PROJECT_ID por el
# ID real y defina FIREBASE_KEY_PATH.
# Requiere el compose de cameia-gateway arriba. Emulator UI: http://localhost:4000.
FIREBASE_AUTH_EMULATOR_HOST=cameia-firebase-emulator:9099

# Solo con un proyecto real (sin el emulador). Ruta al JSON de la cuenta de servicio. Es un
# archivo de desarrollo local y nunca se versiona: pídaselo a quien administra el proyecto de
# Firebase. Fuera de Docker use la ruta del archivo en su máquina; con docker-compose esa ruta
# se monta dentro del contenedor, así que aquí va la del host.
# En Cloud Run se deja vacía: las credenciales salen del entorno con la identidad de la
# cuenta de servicio del despliegue.
# FIREBASE_KEY_PATH=C:/ruta/absoluta/a/firebase-service-account.json

# Apaga el SDK por completo. Solo para levantar la aplicación sin credenciales, por
# ejemplo para revisar la documentación de la API. Con false, el registro de usuarios no
# funciona. En despliegue siempre true.
FIREBASE_ENABLED=true
