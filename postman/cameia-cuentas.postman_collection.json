{
  "info": {
    "name": "cameia-cuentas",
    "description": "Pruebas de API del microservicio de Cuentas. Cada petición verifica su estado y el cuerpo; el script de la colección verifica en todas el Content-Type con charset y, en los errores, application/problem+json, requestId igual al encabezado X-Request-Id y ausencia de detalle interno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const tipo = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
          "pm.test('Content-Type con charset utf-8', () => pm.expect(tipo).to.include('charset=utf-8'));",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error: application/problem+json', () => pm.expect(tipo).to.include('application/problem+json'));",
          "    pm.test('Error: requestId igual a X-Request-Id', () =>",
          "        pm.expect(pm.response.json().requestId).to.eql(pm.response.headers.get('X-Request-Id')));",
          "    pm.test('Error: sin detalle interno', () => {",
          "        const texto = pm.response.text();",
          "        ['Exception', 'SQL', 'org.', 'tech.cameia'].forEach((marca) => pm.expect(texto).to.not.include(marca));",
          "    });",
          "} else {",
          "    pm.test('Éxito: JSON', () => pm.expect(tipo).to.include('application/json'));",
          "}"
        ]
      }
    }
  ],
  "variable": [
