  "item": [
    {
      "name": "Registro",
      "description": "POST /api/v1/users: registro nuevo, repetido con cuenta pendiente y errores previsibles.",
      "item": [
        {
          "name": "1 · 201 registro nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Una marca de tiempo en milisegundos y el número de iteración evitan colisiones entre vueltas rápidas.",
                  "pm.collectionVariables.set('email', 'prueba+' + Date.now() + '-' + pm.info.iteration + '@ejemplo.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Trae id y firebaseUid de 32 caracteres', () => {",
                  "    pm.expect(cuerpo.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(cuerpo.firebaseUid).to.match(/^[0-9a-f]{32}$/);",
                  "});",
                  "pm.test('Cuenta pendiente de verificación y plan FREE', () => {",
                  "    pm.expect(cuerpo.status).to.eql('PENDING_VERIFICATION');",
                  "    pm.expect(cuerpo.plan).to.eql('FREE');",
                  "});",
                  "pm.collectionVariables.set('accountId', cuerpo.id);",
                  "pm.collectionVariables.set('firebaseUid', cuerpo.firebaseUid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\",\n  \"lastName\": \"Pérez\",\n  \"birthDate\": \"12/04/1995\",\n  \"email\": \"{{email}}\",\n  \"password\": \"frase secreta larga\",\n  \"phoneNumber\": \"+573001234567\",\n  \"pronoun\": \"SHE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          }
        },
