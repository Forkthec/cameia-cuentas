{
  "id": "cameia-cuentas-local",
  "name": "cameia-cuentas local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "default",
      "enabled": true
    },
    {
      "key": "rabbitManagementUrl",
      "value": "http://localhost:15673",
      "type": "default",
      "enabled": true,
      "description": "Consola de administración del broker de compose"
    },
    {
      "key": "rabbitUser",
      "value": "cameia",
      "type": "default",
      "enabled": true,
      "description": "Usuario del broker (SPRING_RABBITMQ_USERNAME del .env)"
    },
    {
      "key": "rabbitPassword",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "La del .env local; no se versiona. Se pasa con --env-var rabbitPassword=..."
    },
    {
      "key": "firebaseEmulatorUrl",
      "value": "http://localhost:9099",
      "type": "default",
      "enabled": true,
      "description": "Emulador de Firebase Auth local; solo lo usa la carpeta de cierre de sesión para comprobar la revocación"
    },
    {
      "key": "firebaseProjectId",
      "value": "demo-cameia",
      "type": "default",
      "enabled": true,
      "description": "Proyecto del emulador de Firebase Auth (el mismo FIREBASE_PROJECT_ID del .env local)"
    }
  ],
  "_postman_variable_scope": "environment"
}
